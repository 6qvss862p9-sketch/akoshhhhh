import { useState } from "react";

function App() {
  const [yes, setYes] = useState(false);
  const [position, setPosition] = useState({ x: 0, y: 0 });

  const moveButton = () => {
    setPosition({
      x: Math.random() * 250 - 125,
      y: Math.random() * 150 - 75,
    });
  };

  return (
    <>
      <style>{`
        * {
          box-sizing: border-box;
        }

        body {
          margin: 0;
          font-family: Arial, sans-serif;
        }

        .page {
          min-height: 100vh;
          display: flex;
          justify-content: center;
          align-items: center;
          background: linear-gradient(135deg, #ff758c, #ff7eb3);
          overflow: hidden;
        }

        .card {
          width: 90%;
          max-width: 500px;
          padding: 50px 30px;
          text-align: center;
          background: white;
          border-radius: 30px;
          box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
        }

        .heart {
          font-size: 75px;
          animation: pulse 1s infinite;
        }

        h1 {
          color: #ff416c;
          font-size: 42px;
          margin: 15px 0;
        }

        h2 {
          color: #222;
          margin: 30px 0;
        }

        .buttons {
          display: flex;
          justify-content: center;
          align-items: center;
          gap: 20px;
          min-height: 70px;
        }

        button {
          border: none;
          padding: 15px 30px;
          border-radius: 30px;
          font-size: 18px;
          cursor: pointer;
          transition: 0.3s;
        }

        .yes {
          background: #ff416c;
          color: white;
        }

        .yes:hover {
          transform: scale(1.1);
        }

        .no {
          background: #eee;
          color: #555;
        }

        .big-heart {
          font-size: 90px;
          animation: pulse 1s infinite;
        }

        @keyframes pulse {
          50% {
            transform: scale(1.2);
          }
        }
      `}</style>

      <div className="page">
        <div className="card">
          {!yes ? (
            <>
              <div className="heart">❤️</div>

              <h1>АКОШШШ</h1>

              <h2>шығасың ба?</h2>

              <div className="buttons">
                <button
                  className="yes"
                  onClick={() => setYes(true)}
                >
                  Иә
                </button>

                <button
                  className="no"
                  onMouseEnter={moveButton}
                  style={{
                    transform: `translate(${position.x}px, ${position.y}px)`,
                  }}
                >
                  Жоқ 😅
                </button>
              </div>
            </>
          ) : (
            <div>
              <div className="big-heart">💖</div>

              <h1>Урааа! ❤️</h1>
            </div>
          )}
        </div>
      </div>
    </>
  );
}

export default App;
